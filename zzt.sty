%%%Mat
\newcommand{\Mat}[2]{%
  \text{Mat}%
  \ifthenelse{\equal{#1}{}}{}{_{#1}}%
  \ifthenelse{\equal{#2}{}}{}{^{\rm{#2}}}%
}


%%% Symmetry matrix
\newcommand{\Sym}[3]{%
  \text{Sym}_{#1}^{\tt{#2}}(#3)%
}

%%% Potts_q(x)
\newcommand{\potts}[2]{\text{\tt{Potts}}_{#1}(#2)}

%%% Lattice of q by q Potts
\newcommand{\LPotts}[1]{\mathfrak{L}_{\mathtt{Potts}}{(#1)}}
%%% derivative
\newcommand{\deriv}[3]{\frac{d^{#1} #2}{d #3^{#1}}}

%%% 2 norm
\newcommand{\norm}[1]{||\mathbf{#1}||_2}

